{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/check-conflict.sh\"",
            "timeout": 30,
            "statusMessage": "main과 충돌 확인 중"
          }
        ]
      }
    ]
  }
}
