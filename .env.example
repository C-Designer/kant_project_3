LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
QDRANT_URL=
QDRANT_API_KEY=
# 위 두 주소는 Mac Studio 셀프호스트. 주소는 README, 키는 별도 전달. 공용 Qdrant는 포트까지 https://kant-qdrant.zerocode-studio.com:443 (없으면 클라이언트가 6333에 붙어 timeout). 로컬 docker면 http://localhost:6333
# 생성·평가 모델 (gpt-6-luna). 키 이름은 ChatOpenAI 기본값을 가정했다. 실제 제공 방식이 다르면 config.py와 함께 고친다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Langfuse Users 화면에 보일 내 이름·별칭 (평가 실행 등 내 PC에서 돈 trace에 붙는다)
TRACE_USER=
