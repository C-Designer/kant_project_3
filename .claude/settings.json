{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/whoami.sh\"",
            "timeout": 10,
            "statusMessage": "담당 영역 확인 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check-conflict.sh\"",
            "timeout": 30,
            "statusMessage": "main과 충돌 확인 중"
          }
        ]
      }
    ]
  }
}
